# Etherscan API key for fetching verified contract source code
ETHERSCAN_API_KEY=your_etherscan_api_key

# AI provider credentials (set ONE)
# Anthropic API key for AI-powered analysis
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API key for AI-powered analysis (alternative to Anthropic)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Ethereum RPC URL — use a Sepolia endpoint when auditing on Sepolia
# Alchemy:  https://eth-sepolia.g.alchemy.com/v2/your_key
# Infura:   https://sepolia.infura.io/v3/your_key
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key

# Private key for publishing audit results on-chain (without 0x prefix)
PRIVATE_KEY=your_private_key

# Pinata IPFS pinning credentials
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Deployed ContractLensRegistry contract address
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
